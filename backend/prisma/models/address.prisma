model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  districtCode String   @db.VarChar(20)
  provinceCode String   @db.VarChar(10)
  detail       String?  @db.VarChar(500)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtCode], references: [code])
  province Province @relation(fields: [provinceCode], references: [code])

  @@index([userId])
}

model Province {
  id                           Int     @id @default(autoincrement())
  code                         String  @unique @db.VarChar(10)
  name                         String  @unique @db.VarChar(100)
  nameEn                       String? @map("name_en") @db.VarChar(100)
  fullName                     String? @map("full_name") @db.VarChar(200)
  fullNameEn                   String? @map("full_name_en") @db.VarChar(200)
  codeName                     String? @map("code_name") @db.VarChar(100)
  administrativeUnitId         Int?    @map("administrative_unit_id")
  administrativeUnitShortName  String? @map("administrative_unit_short_name") @db.VarChar(50)
  administrativeUnitFullName   String? @map("administrative_unit_full_name") @db.VarChar(100)
  administrativeUnitFullNameEn String? @map("administrative_unit_full_name_en") @db.VarChar(100)

  districts District[]
  addresses Address[]
  orders    Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([code])
  @@index([name])
  @@index([codeName])
}

model District {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(150)
  nameEn       String?  @map("name_en") @db.VarChar(150)
  fullName     String?  @map("full_name") @db.VarChar(200)
  fullNameEn   String?  @map("full_name_en") @db.VarChar(200)
  codeName     String?  @map("code_name") @db.VarChar(150)
  provinceCode String   @map("province_code") @db.VarChar(10)
  province     Province @relation(fields: [provinceCode], references: [code], onDelete: Cascade)

  administrativeUnitId          Int?    @map("administrative_unit_id")
  administrativeUnitShortName   String? @map("administrative_unit_short_name") @db.VarChar(50)
  administrativeUnitFullName    String? @map("administrative_unit_full_name") @db.VarChar(100)
  administrativeUnitShortNameEn String? @map("administrative_unit_short_name_en") @db.VarChar(50)
  administrativeUnitFullNameEn  String? @map("administrative_unit_full_name_en") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  addresses Address[]

  orders Order[]

  @@index([provinceCode])
  @@index([code])
  @@index([name])
  @@index([codeName])
}
